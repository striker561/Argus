# Argus backend environment
# Copy this file to `.env` and adjust, or rely on the built-in defaults.
# Every value can also be set as a real environment variable.

# --- Core ---
APP_NAME=Argus
APP_CURRENT_VERSION=0.1.0
IS_PRODUCTION=false
LOG_LEVEL=INFO

# --- Database (SQLite by default) ---
# DATABASE_URL must use an async driver (+aiosqlite / +asyncpg), or startup fails.
DATABASE_URL=sqlite+aiosqlite:///./argus.db
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/argus
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30

# --- Redis (required — Argus reads the queues it monitors from here) ---
REDIS_URL=redis://localhost:6379/0

# --- Network (Next.js frontend origin) ---
CORS_ORIGINS=http://localhost:3000
